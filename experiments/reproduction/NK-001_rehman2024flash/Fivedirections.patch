+    "    # needed maps a member name to the edge-list file (member name + '.txt') that is used afterwards.\n",
+    "    # keep lists the members that later cells read again as raw JSON; they are kept under their own name.\n",
+    "    import tarfile, shutil\n",
+    "    os.makedirs(work, exist_ok=True)\n",
+    "    base = os.path.join(work, path)\n",
+    "\n",
+    "    def members():\n",
+    "        with tarfile.open(archive, 'r|gz') as tf:\n",
+    "            for m in tf:\n",
+    "                if m.isfile():\n",
+    "                    with open(base, 'wb') as out:\n",
+    "                        shutil.copyfileobj(tf.extractfile(m), out, 1 << 20)\n",
+    "                    yield m.name\n",
+    "\n",
+    "    id_nodetype_map = {}\n",
+    "    conflicts = 0\n",
+    "    n_members = 0\n",
+    "    for name in members():\n",
+    "        n_members += 1\n",
+    "        sub = process_data(base)\n",
+    "        for k, v in sub.items():\n",
+    "            if k in id_nodetype_map and id_nodetype_map[k] != v:\n",
+    "                conflicts += 1\n",
+    "        id_nodetype_map.update(sub)\n",
+    "    print(f'streamed {n_members} members, {len(id_nodetype_map)} nodes, {conflicts} conflicting node types')\n",
+    "\n",
+    "    remaining = set(needed)\n",
+    "    for name in members():\n",
+    "        if name in remaining:\n",
+    "            process_edges(base, id_nodetype_map)\n",
+    "            shutil.move(base + '.txt', name + '.txt')\n",
+    "            if name in keep:\n",
+    "                shutil.move(base, name)\n",
+    "            remaining.discard(name)\n",
+    "            if not remaining:\n",
+    "                break\n",
+    "    if os.path.exists(base):\n",
+    "        os.remove(base)\n",
+    "    return id_nodetype_map\n",
