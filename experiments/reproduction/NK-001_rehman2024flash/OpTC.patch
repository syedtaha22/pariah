+    "def load_events_from_hosts_lean(hosts):\n",
+    "    # Changed from upstream: the file is read line by line and each event is reduced to the fields\n",
+    "    # that the later cells use. The events are labeled and de-duplicated while reading, with the same\n",
+    "    # rules and order as Extract_Semantic_Info and Traversal_Rules, instead of keeping every event.\n",
+    "    # The set of all actor and object ids is kept separately because EntitySet is built from it.\n",
+    "    fields = ('actorID', 'objectID', 'action', 'object', 'pid', 'ppid', 'timestamp')\n",
+    "    property_keys = ('parent_image_path', 'image_path', 'command_line', 'file_path', 'src_ip',\n",
+    "                     'src_port', 'dest_ip', 'dest_port', 'direction', 'module_path')\n",
+    "    all_ids = set()\n",
+    "    filtered_data = {}\n",
+    "    for host in hosts:\n",
+    "        path = f'SysClient0{host}.systemia.com.txt'\n",
+    "        with open(path, 'r') as file:\n",
+    "            for line in file:\n",
+    "                x = json.loads(line)\n",
+    "                all_ids.add(x['actorID'])\n",
+    "                all_ids.add(x['objectID'])\n",
+    "                event = {k: x[k] for k in fields if k in x}\n",
+    "                if 'properties' in x:\n",
+    "                    event['properties'] = {k: x['properties'][k] for k in property_keys if k in x['properties']}\n",
+    "                event = Extract_Semantic_Info(event)\n",
+    "                if event and is_valid_entry(event):\n",
+    "                    key = (event['action'], event['actorID'], event['objectID'], event['object'],\n",
+    "                           event['pid'], event['ppid'])\n",
+    "                    filtered_data[key] = event\n",
+    "    return list(filtered_data.values()), all_ids"
    ]
